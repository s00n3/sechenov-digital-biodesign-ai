---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ContentCards from "@/components/ContentCards.astro";
import { competencies } from "@/data/site";
---
<BaseLayout title="Наука и разработки" description="НИР, НИОКР, AI-сервисы, биодизайн и разработка медицинских цифровых продуктов.">
  <PageHero label="Наука и разработки" title={"Исследования, НИОКР и <span>цифровая разработка</span>"} description="Соединяем академическую экспертизу Сеченовского Университета с инженерной реализацией и продуктовой практикой." ctaPrimary={{ label: "Обсудить НИР/НИОКР", href: "/kontakty/?topic=rd#request-form" }} ctaSecondary={{ label: "Обсудить разработку", href: "/kontakty/?topic=development#request-form" }} image="/uploads/placeholders/research-lab.jpg" imageAlt="Исследователи проводят лабораторную работу" />
  <section class="section section-dark" id="nir-niokr"><div class="container"><SectionHeader label="НИР/НИОКР" title="Научные и опытно-конструкторские работы" subtitle="Методологии, протоколы, обработка данных, эксперименты, публикации и отчётность." /><ContentCards columns="two" items={[{icon:"science",title:"Прикладные исследования",desc:"Проверяем гипотезы, строим модели и оцениваем клиническую применимость.",href:"/kontakty/?topic=rd#request-form"},{icon:"ethics",title:"Валидация и доказательность",desc:"Готовим дизайн оценки, метрики качества, документацию и рекомендации.",href:"/kontakty/?topic=rd#request-form"}]} /></div></section>
  <section class="section section-purple" id="digital-services"><div class="container"><SectionHeader label="Digital services" title="Разработка AI и цифровых сервисов" subtitle="Прототипы, web-сервисы, аналитические панели, ML-модули и интеграция в процессы." /><ContentCards columns="two" items={[{icon:"ai",title:"AI-модели",desc:"Классификация, прогнозирование, анализ изображений, текстов и табличных данных.",href:"/kontakty/?topic=development#request-form"},{icon:"product",title:"Медицинские продукты",desc:"Пользовательские сценарии, интерфейсы, архитектура и пилотное внедрение.",href:"/kontakty/?topic=development#request-form"}]} /></div></section>
  <section class="section section-deep"><div class="container"><SectionHeader label="Компетенции" title="Направления экспертизы" /><ContentCards items={competencies.map(([icon,title,desc]) => ({icon,title,desc}))} /></div></section>
</BaseLayout>
