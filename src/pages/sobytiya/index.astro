---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { formatDate, getPublishedCollection } from "@/utils/content";
import { withBase } from "@/utils/paths";
const events = await getPublishedCollection("events");
events.sort((a,b)=>+a.data.eventDate-+b.data.eventDate);
---
<BaseLayout title="События" description="События, конференции, школы и интенсивы института.">
  <PageHero label="События" title={"События и <span>открытые форматы</span>"} description="Конференции, хакатоны, школы и публичные мероприятия из CMS." image="/uploads/placeholders/medical-education.jpg" imageAlt="Университетская аудитория с образовательным мероприятием" />
  <section class="section section-dark"><div class="container"><SectionHeader label="Календарь" title="Все события" /><div class="card-grid">{events.map((item)=><a class="cut-card" href={withBase(`/sobytiya/${item.slug}/`)} data-reveal>{item.data.image && <img class="card-media compact" src={withBase(item.data.image)} alt={item.data.title} loading="lazy" decoding="async" />}<span class="kicker">{item.data.format}</span><p class="meta">{formatDate(item.data.eventDate)}{item.data.location ? ` · ${item.data.location}` : ""}</p><h2 class="card-title">{item.data.title}</h2><p class="card-desc">{item.data.description}</p><span class="arrow-link" style="margin-top:22px">Подробнее →</span></a>)}</div></div></section>
</BaseLayout>
