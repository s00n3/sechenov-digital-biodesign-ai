---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { getCollection } from "astro:content";
import { formatDate, isPublished } from "@/utils/content";
export async function getStaticPaths() {
  const entries = (await getCollection("news")).filter(isPublished);
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
---
<BaseLayout title={entry.data.seoTitle || entry.data.title} description={entry.data.seoDescription || entry.data.description} image={entry.data.image || "/og-default.svg"} canonical={`/novosti/${entry.slug}/`}>
  <PageHero label={entry.data.category} title={entry.data.title} description={`${entry.data.description} ${formatDate(entry.data.date)}`} image={entry.data.image || "/uploads/placeholders/research-lab.jpg"} imageAlt={entry.data.title} />
  <section class="section section-dark"><div class="container prose"><Content /></div></section>
</BaseLayout>
