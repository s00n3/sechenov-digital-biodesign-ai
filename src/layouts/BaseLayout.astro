---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";
import { withBase } from "@/utils/paths";
import "@/styles/global.css";

const {
  title = site.name,
  description = "Институт цифрового биодизайна и искусственного интеллекта в медицине Сеченовского Университета.",
  image = "/og-default.svg",
  canonical,
} = Astro.props;
const siteUrl = Astro.site?.toString() || site.url;
const canonicalUrl = new URL(canonical ? withBase(canonical) : Astro.url.pathname, siteUrl).toString();
const pageTitle = title.includes("Сеченов") ? title : `${title} - ${site.university}`;
---
<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("site-theme");
        if (theme === "dark") document.documentElement.dataset.theme = "dark";
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(withBase(image), siteUrl).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={withBase("/favicon.svg")} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline src={withBase("/site.js")} defer></script>
  </body>
</html>
